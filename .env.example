APP_NAME="PrimeOS AcadSch"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://school.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Daily rotating logs for production monitoring
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database (MySQL for Production / SQLite for embedded test)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=acadsch_prod
DB_USERNAME=acadsch_user
DB_PASSWORD=your_secure_db_password

# Session, Cache & Queue
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# Mail Configuration (SMTP / Mailgun / Postmark)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="admissions@school.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# OwnPay Static UPI QR & Counter Collection
OWNPAY_UPI_VPA="school@upi"
OWNPAY_PAYEE_NAME="PrimeOS Public School"
OWNPAY_QR_ENABLED=true

# Institutional Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Installation Wizard Key (32+ chars random string)
SCHOOL_INSTALLER_KEY=

# Sanctum personal access token lifetime (minutes)
SANCTUM_EXPIRATION=10080

VITE_APP_NAME="${APP_NAME}"
